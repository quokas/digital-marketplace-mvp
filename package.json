{
  "name": "testgg",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm --prefix client run dev\"",
    "dev:server": "tsx watch server/src/main.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm --prefix client run build && npm run build:server",
    "start": "node server/dist/main.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "test:integration": "tsx --test server/tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}